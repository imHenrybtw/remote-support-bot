# ═══════════════════════════════════════════════════════════════════════════════
#  .env.example — Copie para .env e preencha os valores reais.
#
#  ⚠️  NUNCA commite o arquivo .env — ele está no .gitignore.
#  ⚠️  Nunca compartilhe este arquivo com credenciais preenchidas.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Active Directory (LDAP/LDAPS) ───────────────────────────────────────────
AD_BIND_PASSWORD=

# ─── SMTP ─────────────────────────────────────────────────────────────────────
# Senha do usuário SMTP. Deixe vazio se o servidor não exigir autenticação.
SMTP_PASSWORD=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ─── Microsoft Teams ─────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=

# ─── GLPI — OAuth2 (GLPI 11+) ────────────────────────────────────────────────
# Credenciais do cliente OAuth2 criado em Configuração → OAuth → Aplicações.
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
GLPI_OAUTH_USERNAME=
GLPI_OAUTH_PASSWORD=

# ─── GLPI — Legacy REST API (GLPI 10 e anteriores) ───────────────────────────
# Deixe em branco se estiver usando OAuth2 acima.
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# ─── Firewalls Fortigate ──────────────────────────────────────────────────────
# Uma variável por entrada definida em config.yaml → firewalls[].name.
# O nome da variável é sempre:  FW_TOKEN_<name>
# onde <name> é EXATAMENTE o valor do campo "name" no YAML (case-sensitive).
#
# Exemplos para os firewalls do config.yaml de exemplo:
FW_TOKEN_Matriz=
FW_TOKEN_FilialSP=
FW_TOKEN_FilialCtba=

# ─── Painel web de auditoria (Em desenvolvimento) ──────────────────────────────────────────────────
# Deixe WEB_PASSWORD vazio para desabilitar o painel completamente.
WEB_USERNAME=admin
WEB_PASSWORD=
